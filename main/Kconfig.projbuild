menu "小智助手配置"

config OTA_URL
    string "默认 OTA 更新地址"
    default "https://api.tenclass.net/xiaozhi/ota/"
    help
        应用程序将访问此 URL 以检查新固件和服务器地址。

choice
    prompt "资源文件烧录"
    default FLASH_DEFAULT_ASSETS
    help
        选择要烧录的资源文件。

    config FLASH_NONE_ASSETS
        bool "不烧录资源文件"
    config FLASH_DEFAULT_ASSETS
        bool "烧录默认资源文件"
    config FLASH_CUSTOM_ASSETS
        bool "烧录自定义资源文件"
endchoice

config CUSTOM_ASSETS_FILE
    depends on FLASH_CUSTOM_ASSETS
    string "自定义资源文件"
    default "assets.bin"
    help
        要烧录的自定义资源文件。
        可以是相对于项目目录的本地文件，也可以是远程 URL。

choice
    prompt "默认语言"
    default LANGUAGE_ZH_CN
